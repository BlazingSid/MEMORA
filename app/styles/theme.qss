QMainWindow {
    background: #F3F2EF;
}

QWidget {
    color: #171717;
    font-family: "Segoe UI";
    font-size: 14px;
}

QWidget#ApplicationRoot,
QWidget#HomeContent {
    background: transparent;
}

QFrame#Sidebar {
    background: #252525;
    border: 1px solid #303030;
    border-radius: 28px;
}

QLabel#BrandMark {
    background: #E87550;
    border-radius: 19px;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
}

QLabel#Logo {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1px;
}

QPushButton#NavItem {
    background: transparent;
    border: none;
    border-radius: 14px;
    color: #BDBDBD;
    font-size: 14px;
    font-weight: 500;
    padding: 0;
    text-align: left;
}

QPushButton#NavItem:hover {
    background: #333333;
    color: #FFFFFF;
}

QPushButton#NavItem[active="true"] {
    background: #3A3A3A;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#NavItem:pressed {
    background: #454545;
}

QPushButton#NavItem:disabled {
    background: transparent;
    color: #706A63;
}

QLabel#NavIcon {
    background: #333333;
    border-radius: 14px;
    color: #C8C8C8;
    font-size: 13px;
    font-weight: 600;
}

QLabel#NavLabel {
    background: transparent;
    color: #BDBDBD;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#NavItem:hover QLabel#NavIcon {
    background: #454545;
    color: #FFFFFF;
}

QPushButton#NavItem:hover QLabel#NavLabel,
QPushButton#NavItem[active="true"] QLabel#NavLabel {
    color: #FFFFFF;
}

QPushButton#NavItem[active="true"] QLabel#NavIcon {
    background: #E87550;
    color: #FFFFFF;
}

QPushButton#NavItem:disabled QLabel#NavIcon {
    background: #2D2A27;
    color: #706A63;
}

QPushButton#NavItem:disabled QLabel#NavLabel {
    color: #706A63;
}

QFrame#ContentShell {
    background: #FFFFFF;
    border: 1px solid #E5E3DF;
    border-radius: 28px;
}

QStackedWidget#MainPages,
QScrollArea#PageScrollArea {
    background: transparent;
    border: none;
}

QScrollArea#PageScrollArea > QWidget > QWidget {
    background: transparent;
}

QLabel#PageTitle {
    color: #171717;
    font-size: 30px;
    font-weight: 700;
}

QLabel#Subtitle,
QLabel#SectionSubtitle {
    color: #777777;
    font-size: 14px;
}

QLabel#CaptureHint {
    color: #A0A0A0;
    font-size: 12px;
}

QLabel#SectionTitle {
    color: #171717;
    font-size: 18px;
    font-weight: 600;
}

QFrame#GlassCard,
QFrame#RememberCard,
QFrame#ChatPanel,
QFrame#ReflectionCard,
QFrame#StatCard,
QFrame#MemoryCard,
QFrame#EmptyMemoryCard {
    background: #FFFFFF;
    border: 1px solid #E5E3DF;
    border-radius: 20px;
}

QFrame#RememberCard {
    background: #F8F7F4;
}

QFrame#ChatPanel {
    border-color: #E5E3DF;
}

QFrame#MemoryCard:hover {
    background: #FFFFFF;
    border: 1px solid #DCD7D0;
}

QLabel#MemoryIcon {
    background: #FCE9E2;
    border-radius: 17px;
    color: #D96542;
    font-size: 12px;
    font-weight: 700;
}

QLabel#StatLabel,
QLabel#AssistantLabel {
    color: #A0A0A0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#MemoryContent {
    color: #171717;
    font-size: 14px;
    font-weight: 500;
}

QLabel#MemoryTimestamp,
QLabel#StatDetail,
QLabel#EmptyStateDetail {
    color: #777777;
    font-size: 12px;
}

QLabel#EmptyStateTitle,
QLabel#ReflectionTitle {
    color: #171717;
    font-size: 15px;
    font-weight: 600;
}

QLabel#StatValue {
    color: #171717;
    font-size: 26px;
    font-weight: 700;
}

QFrame#AnswerSurface {
    background: #F8F7F4;
    border: 1px solid #E5E3DF;
    border-radius: 16px;
}

QLineEdit {
    background: #FFFFFF;
    border: 1px solid #E5E3DF;
    border-radius: 14px;
    color: #171717;
    padding: 10px 14px;
    selection-background-color: #F5C7B6;
}

QLineEdit:hover {
    border-color: #DCD7D0;
}

QLineEdit:focus {
    border: 1px solid #E87550;
}

QLineEdit:disabled {
    background: #F8F7F4;
    border-color: #E5E3DF;
    color: #A0A0A0;
}

QFrame#SearchBar,
QFrame#RememberBar,
QFrame#AskBar {
    background: #FFFFFF;
    border: 1px solid #E5E3DF;
    border-radius: 16px;
}

QFrame#SearchBar:hover,
QFrame#RememberBar:hover,
QFrame#AskBar:hover {
    border-color: #DCD7D0;
}

QFrame#SearchBar[focused="true"],
QFrame#RememberBar[focused="true"],
QFrame#AskBar[focused="true"] {
    border: 1px solid #E87550;
}

QLineEdit#SearchBarInput,
QLineEdit#MemoryInput,
QLineEdit#QuestionInput {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 7px 9px;
}

QLineEdit#SearchBarInput:hover,
QLineEdit#MemoryInput:hover,
QLineEdit#QuestionInput:hover,
QLineEdit#SearchBarInput:focus,
QLineEdit#MemoryInput:focus,
QLineEdit#QuestionInput:focus {
    border: none;
}

QPushButton#SearchBarAction,
QPushButton#RememberButton,
QPushButton#AskButton,
QPushButton#PrimaryButton {
    background: #E87550;
    border: none;
    border-radius: 12px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    min-width: 76px;
    padding: 0 16px;
}

QPushButton#SearchBarAction:hover,
QPushButton#RememberButton:hover,
QPushButton#AskButton:hover,
QPushButton#PrimaryButton:hover {
    background: #D96542;
}

QPushButton#SearchBarAction:pressed,
QPushButton#RememberButton:pressed,
QPushButton#AskButton:pressed,
QPushButton#PrimaryButton:pressed {
    background: #B9553B;
}

QPushButton#SearchBarAction:disabled,
QPushButton#RememberButton:disabled,
QPushButton#AskButton:disabled,
QPushButton#PrimaryButton:disabled {
    background: #EBC2B4;
    color: #FFF8F4;
}

QTextEdit {
    background: #FFFFFF;
    border: 1px solid #E5E3DF;
    border-radius: 14px;
    color: #171717;
    padding: 12px;
    selection-background-color: #F5C7B6;
}

QTextEdit:focus {
    border: 1px solid #E87550;
}

QTextEdit#AnswerBox {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 1px 0 0;
}

QTextEdit#AnswerBox:focus {
    border: none;
}

QTextEdit:disabled {
    background: #F8F7F4;
    color: #A0A0A0;
}

QScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 10px 5px 10px 0;
    width: 7px;
}

QScrollBar::handle:vertical {
    background: #D8D4CE;
    border-radius: 3px;
    min-height: 26px;
}

QScrollBar::handle:vertical:hover {
    background: #C6C0B8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
}
